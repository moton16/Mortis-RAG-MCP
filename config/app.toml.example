# Obsidian RAG MCP application configuration example.
# Copy this file to config/app.toml (or ~/.mortis_rag_mcp/config.toml) and replace
# provider-specific values. The runtime parser remains the source of truth
# for accepted keys.
#
# 0.3.0 起本服务不再绑定任何笔记目录：把你的文件夹注册为知识库只需调用一次
# kb_init 工具（注册表持久化在 ~/.mortis_rag_mcp/vaults.toml，兼容旧名 ~/.vault_mcp/vaults.toml）。
# 因此这里没有 [vault].path —— 旧配置里的该项仍会被识别并自动迁移进注册表。

# 提示：embedding/reranker 支持任意 OpenAI 兼容 HTTP 端点，不绑定特定云服务商。
# 云端服务商（如 SiliconFlow、DeepSeek 等）或本地部署模型（如 Ollama http://localhost:11434/v1/embeddings、LM Studio、vLLM、Xinference 等）均可直接接入。
# 注意事项：dimension 必须与模型实际输出维度严格一致；send_dimensions 仅在支持定长截断/MRL 维度裁剪的模型端点开启。

[embedding]
# static is deterministic/local and must not call an LLM or external model.
# Set mode = "external" only when the external endpoint is available.
mode = "static"
dimension = 384
endpoint = "https://api.siliconflow.cn/v1/embeddings"
model = "BAAI/bge-m3"
# 是否向 API 发送 dimensions 参数（支持 MRL 裁剪的模型可开；标准定长端点请保持 false）。
send_dimensions = false
# Prefer environment interpolation over committing a secret.
# api_key 为空时会自动回退读取环境变量 MORTIS_RAG_API_KEY（同时兼容 VAULT_MCP_API_KEY）。
api_key = "${MORTIS_RAG_API_KEY}"
timeout = 30
# 0.5.0：失败重试（429/5xx/网络错误）。max_retries 越大，单批请求在端点
# 不可达时卡得越久（每次尝试吃满一个 timeout），且嵌入是按次计费的。
max_retries = 3
batch_size = 32
retry_backoff = 1.0

[reranker]
enabled = false
endpoint = "https://api.siliconflow.cn/v1/rerank"
model = "BAAI/bge-reranker-v2-m3"
api_key = "${MORTIS_RAG_API_KEY}"
timeout = 30
# rerank 走 kb_search 的同步路径：重试次数默认 1，避免端点故障时一次搜索
# 卡 4×timeout。
max_retries = 1
retry_backoff = 1.0
# When enabled, provider failure must fall back to base retrieval order.

[index]
chunk_size = 1200
chunk_overlap = 0
debounce_seconds = 0.5
# 0.5.0：注入图片 alt/图注使其可检索。注意这会改写 chunk content → chunk.id，
# 开启 = 全库重新 embedding（一次付费操作）。
inject_image_captions = false
# 混合检索三路 RRF 各自的候选宽度与单次 rerank 上限。
rrf_per_route = 40
rerank_cap = 60
# 单次 kb_search 允许返回的最大条数（top_k / limit 的上限夹取）。
max_top_k = 200
# 文件监听方式："auto"（默认，Windows 原生 ReadDirectoryChangesW，失败退轮询）、
# "native"、"poll"（0.4.1 及以前行为）。
watch_method = "auto"
# 原生监听期间的低频全量对账兜底秒数；<=0 关闭兜底。
watch_fallback_interval = 30.0
# 混合检索：FTS5 BM25 + 向量余弦 + bigram 词法三路 RRF 融合（默认 true）。
# 设为 false 完整还原旧「词法软信号 + 余弦」行为。需要 [cache] enabled = true。
use_hybrid = true
# kb_read 单次读取最大字符数截断阈值，防止拉取整篇大文档撑爆模型上下文或击穿宿主缓冲区。
# 默认 20000 字符；防御范围 100 ~ 1000000。
read_max_chars = 20000

[vector]
# 向量存储后端："memory"（默认，numpy 暴力扫描，零依赖）或
# "sqlite_vec"（磁盘后端：pip install "mortis-rag-mcp[vec]" 后启用；向量存
# 磁盘 sqlite，不驻留内存——13k 切片约释放 55MB RAM；首次切换自动从 .bin
# 缓存迁移，不触发全量重嵌；未安装/加载失败自动回退 memory）。
backend = "memory"

[cache]
# Disk cache of chunk signatures + embeddings so restarts skip re-embedding.
# Defaults: enabled = true (when the section is absent it is still enabled),
# dir = ~/.mortis_rag_mcp_cache (兼容旧名 ~/.vault_mcp_cache), embedding_max_workers = 6.
# 未在此处显式写 dir 时，默认落点可用环境变量覆盖：
#   MORTIS_RAG_CACHE_DIR（新名，优先）/ VAULT_MCP_CACHE_DIR（旧名兼容）。
# 显式写了 dir 则以此处为准。
enabled = true
# Concurrent embedding requests during full rebuilds.
embedding_max_workers = 2
# placement = "home" (default): cache under `dir`, shared for all vaults.
# placement = "vault": cache inside each vault's own `.mcp_cache/` subfolder,
# keeping every vault's vectors next to its notes. Recommended when
# distributing vault folders to other machines/users.
placement = "home"
subdir = ".mcp_cache"

# The current indexer always filters .md files, .obsidian, and common
# temporary Markdown names (~*.md, *.tmp.md, *.swp.md, *.swo.md).
# Those filters are implementation defaults, not configurable keys today.

# ── PDF/Office 摄取层（默认关闭）────────────────────────────
# 开启后可用 kb_ingest 把库里的 PDF/DOCX/PPTX/XLSX 解析成 Markdown 收进
# .mortis-parsed/ 子目录并纳入索引。解析走 MinerU 云端 API：
#   - 配了 api_key → v4 精准接口（≤200MB/200页，每天 1000 页高优先级额度）
#   - 没配 api_key → Agent 免登接口（≤10MB/20页，IP 限频，零配置试用）
# 云端都失败且装了 pymupdf（pip install pymupdf）→ 本地纯文本兜底。
[ingest]
enabled = false
# 自动监听并摄取知识库内的 PDF/Office 文档（默认关闭：必须显式配置 enabled=true 与 auto_watch=true 才生效）。
# 开启后会自动扫描并排队摄取知识库内既有文档及后续新增/修改的文档。
# 支持所有 INGEST_EXTS 格式（.pdf, .doc, .docx, .ppt, .pptx, .xls, .xlsx）。
# 注意：自动上传可能会消耗 MinerU 云端配额并产生 API 计费费用，并存在云端数据传输隐私影响。
# 轮询扫描节奏（cadence）遵循 [index] 的 watch_fallback_interval 周期。
# 修改此项配置后须重启服务方可生效。
auto_watch = false
# 单文件摄取尺寸上限（单位 MiB，以 1024*1024 字节计，默认 20 MiB）。
# 设为 0 表示不限制单文件尺寸。超过上限的文件将被跳过摄取并记录诊断原因。
max_file_size_mb = 20
# api_key = "${MINERU_API_KEY}"
# model_version = "vlm"

# ── 本地诊断日志（默认关闭）────────────────────────────────
# 开启后在本地输出结构化 jsonl 诊断日志，用于排查检索退化与阶段耗时。
# 遵循严格隐私白名单（10 键）：仅记录 ts, corr_id, tool, stage, ms, result_count,
# response_bytes, truncated, error_code, version。
# 绝不记录：搜索关键词 query、正文/片段、文件名/路径、标签、别名、密钥、堆栈。
[diag]
enabled = false
# 日志存储目录（写入 ~/.mortis_rag_mcp/diag.log，支持 ~ 展开与环境变量）
dir = "~/.mortis_rag_mcp"
# 单个日志文件最大字节（默认 1MB = 1048576，超限后轮转为 .1）
max_bytes = 1048576
# 轮转保留文件数（默认 2 个）
files = 2
# 历史日志最长保留天数（默认 7 天，过期惰性自动清理）
retention_days = 7

