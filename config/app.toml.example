# Obsidian RAG MCP application configuration example.
# Copy this file to config/app.toml (or ~/.vault_mcp/config.toml) and replace
# provider-specific values. The runtime parser remains the source of truth
# for accepted keys.
#
# 0.3.0 起本服务不再绑定任何笔记目录：把你的文件夹注册为知识库只需调用一次
# kb_init 工具（注册表持久化在 ~/.vault_mcp/vaults.toml，跨重启/跨设备可用）。
# 因此这里没有 [vault].path —— 旧配置里的该项仍会被识别并自动迁移进注册表。

[embedding]
# static is deterministic/local and must not call an LLM or external model.
# Set mode = "external" only when the external endpoint is available.
mode = "static"
dimension = 384
endpoint = "https://api.siliconflow.cn/v1/embeddings"
model = "BAAI/bge-m3"
send_dimensions = false
# Prefer environment interpolation over committing a secret.
# api_key 为空时会自动回退读取环境变量 VAULT_MCP_API_KEY。
api_key = "${VAULT_MCP_API_KEY}"
timeout = 30
# 0.5.0：失败重试（429/5xx/网络错误）。max_retries 越大，单批请求在端点
# 不可达时卡得越久（每次尝试吃满一个 timeout），且嵌入是按次计费的。
max_retries = 3
batch_size = 32
retry_backoff = 1.0

[reranker]
enabled = false
endpoint = "https://api.siliconflow.cn/v1/rerank"
model = "BAAI/bge-reranker-v2-m3"
api_key = "${VAULT_MCP_API_KEY}"
timeout = 30
# rerank 走 kb_search 的同步路径：重试次数默认 1，避免端点故障时一次搜索
# 卡 4×timeout。
max_retries = 1
retry_backoff = 1.0
# When enabled, provider failure must fall back to base retrieval order.

[index]
chunk_size = 1200
chunk_overlap = 0
debounce_seconds = 0.5
# 0.5.0：注入图片 alt/图注使其可检索。注意这会改写 chunk content → chunk.id，
# 开启 = 全库重新 embedding（一次付费操作）。
inject_image_captions = false
# 混合检索三路 RRF 各自的候选宽度与单次 rerank 上限。
rrf_per_route = 40
rerank_cap = 60
# 单次 kb_search 允许返回的最大条数（top_k / limit 的上限夹取）。
max_top_k = 200
# 文件监听方式："auto"（默认，Windows 原生 ReadDirectoryChangesW，失败退轮询）、
# "native"、"poll"（0.4.1 及以前行为）。
watch_method = "auto"
# 原生监听期间的低频全量对账兜底秒数；<=0 关闭兜底。
watch_fallback_interval = 30.0
# 混合检索：FTS5 BM25 + 向量余弦 + bigram 词法三路 RRF 融合（默认 true）。
# 设为 false 完整还原旧「词法软信号 + 余弦」行为。需要 [cache] enabled = true。
use_hybrid = true

[vector]
# 向量存储后端："memory"（默认，numpy 暴力扫描，零依赖）或
# "sqlite_vec"（磁盘后端：pip install "mortis-rag-mcp[vec]" 后启用；向量存
# 磁盘 sqlite，不驻留内存——13k 切片约释放 55MB RAM；首次切换自动从 .bin
# 缓存迁移，不触发全量重嵌；未安装/加载失败自动回退 memory）。
backend = "memory"

[cache]
# Disk cache of chunk signatures + embeddings so restarts skip re-embedding.
# Defaults: enabled = true (when the section is absent it is still enabled),
# dir = ~/.vault_mcp_cache, embedding_max_workers = 6.
enabled = true
# Concurrent embedding requests during full rebuilds.
embedding_max_workers = 2
# placement = "home" (default): cache under `dir`, shared for all vaults.
# placement = "vault": cache inside each vault's own `.mcp_cache/` subfolder,
# keeping every vault's vectors next to its notes. Recommended when
# distributing vault folders to other machines/users.
placement = "home"
subdir = ".mcp_cache"

# The current indexer always filters .md files, .obsidian, and common
# temporary Markdown names (~*.md, *.tmp.md, *.swp.md, *.swo.md).
# Those filters are implementation defaults, not configurable keys today.
